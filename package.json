{
  "name": "routista.antigravity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run lint && ([ -n \"$VERCEL\" ] || npm test)",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "export": "next build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fixtures:routes": "CAPTURE_FIXTURES=1 vitest run tests/capture",
    "test:live": "RUN_LIVE_ROUTE_TESTS=1 vitest run tests/live tests/routeAccuracy.test.ts",
    "deploy": "npm run export && firebase deploy --only hosting",
    "test:baseline": "UPDATE_BASELINE=1 vitest run tests/integration"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.69.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/redis": "^1.38.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "leaflet-image": "^0.4.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-intl": "^4.5.5",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.409.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "xmlbuilder2": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.16",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^4.0.13"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
